# Copy to .env.local and fill in. .env.local is gitignored.

# Anthropic API key — powers the free-form chat.
# Get one at https://console.anthropic.com/settings/keys
# If this is missing the site still works: preset chips are pre-written and
# never call the API. Only typed questions degrade, to a friendly offline notice.
ANTHROPIC_API_KEY=

# Secret used to sign the per-visitor question-quota cookie.
# Any long random string. Generate one with:
#   openssl rand -base64 32
# Changing it resets everyone's quota, which is harmless.
CHAT_SECRET=
